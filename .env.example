# Supabase (optional — form storage). Leave unset if using email-only.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# IP_HASH_SALT=change-me-to-a-long-random-string

# Nodemailer / Gmail SMTP (form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@friendlysupportlimited.co.uk
SMTP_PASS=zudugnwyttydyaxc


# Where form submissions are delivered
OFFICE_EMAIL=info@friendlysupportlimited.co.uk
MAIL_FROM="Friendly Support Limited <info@friendlysupportlimited.co.uk>"

# Optional — Cloudflare Turnstile
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
