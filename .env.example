# ---------------------------------------------------------------------------
# Friendly Support Limited — environment variables
# Copy to .env.local (never commit real values)
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the publishable/anon key only if you add public clients later:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only — NEVER expose to the browser (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional salt for hashing client IPs before storage
IP_HASH_SALT=change-me-to-a-long-random-string

# Resend (emails to office + acknowledgement)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
OFFICE_EMAIL=info@friendlysupportlimited.co.uk
MAIL_FROM="Friendly Support Limited <no-reply@friendlysupportlimited.co.uk>"

# Optional — Cloudflare Turnstile
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
